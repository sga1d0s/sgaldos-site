---
import { experienceCopy } from "@/data/experience";
import "@/styles/experience.css";
import "@/styles/showcase.css";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const copy = experienceCopy[lang];
const contactUrl = lang === "es" ? "/es/contact" : "/contact";
---

<div class="experience-page">
  <section class="experience-hero showcase-hero section-sm">
    <div class="container showcase-wide">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <div class="hero-footer">
        <p class="showcase-intro showcase-reading">{copy.introduction}</p>
        <a class="download-link" href={copy.cvUrl} download>
          {copy.downloadCv}<span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="profile-section section-sm">
    <div class="container showcase-wide">
      <div class="profile-panel">
        <div class="profile-number">01</div>
        <div class="profile-heading">
          <p class="section-kicker">{copy.profileLabel}</p>
          <h2>{copy.profileTitle}</h2>
        </div>
        <div class="profile-content">
          <p>{copy.profileText}</p>
          <ul>
            {copy.profilePoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline-section section-sm" aria-labelledby="timeline-title">
    <div class="container showcase-wide">
      <div class="showcase-section-heading">
        <div>
          <span class="showcase-section-index">02</span>
          <h2 id="timeline-title">{copy.timelineTitle}</h2>
        </div>
        <span class="showcase-section-meta">2004 — {copy.present}</span>
      </div>

      <div class="timeline">
        {
          copy.experience.map((entry, index) => (
            <article class="timeline-entry">
              <div class="timeline-marker">
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <p class="timeline-period">{entry.period}</p>
              <div class="timeline-company">
                <h3>{entry.company}</h3>
                <p>{entry.role}</p>
              </div>
              <div class="timeline-details">
                <p>{entry.description}</p>
                {entry.highlights && (
                  <ul>
                    {entry.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="previous-experience">
        <h3>{copy.previousTitle}</h3>
        <div class="previous-grid">
          {
            copy.previousExperience.map((entry) => (
              <article>
                <p class="timeline-period">{entry.period}</p>
                <h4>{entry.company}</h4>
                <strong>{entry.role}</strong>
                <p>{entry.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="skills-section section-sm" aria-labelledby="skills-title">
    <div class="container showcase-wide">
      <div class="skills-panel">
        <div class="skills-intro">
          <span>03</span>
          <p class="section-kicker">Stack</p>
          <h2 id="skills-title">{copy.skillsTitle}</h2>
          <p>{copy.skillsIntro}</p>
        </div>
        <div class="skill-groups">
          {
            copy.skillGroups.map((group) => (
              <div class="skill-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="details-section section-sm">
    <div class="container showcase-wide details-grid">
      <div class="education-panel">
        <div class="detail-heading">
          <span>04</span>
          <h2>{copy.educationTitle}</h2>
        </div>
        <div class="education-list">
          {
            copy.education.map((entry) => (
              <article>
                <span>{entry.year}</span>
                <div>
                  <h3>{entry.title}</h3>
                  <p>{entry.subject}</p>
                  <small>{entry.school}</small>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="side-details">
        <div class="languages-panel">
          <h2>{copy.languagesTitle}</h2>
          <ul>
            {
              copy.languages.map((language) => (
                <li>
                  <>
                    <span>{language.name}</span>
                    <strong>{language.level}</strong>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="cv-panel">
          <p class="section-kicker">{copy.cvLabel}</p>
          <p>{copy.cvText}</p>
          <a class="download-link" href={copy.cvUrl} download>
            {copy.downloadCv}<span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section section-sm">
    <div class="container showcase-wide">
      <div class="contact-panel">
        <div>
          <p class="section-kicker">{copy.contactLabel}</p>
          <h2>{copy.contactTitle}</h2>
          <p>{copy.contactText}</p>
        </div>
        <a href={contactUrl}
          >{copy.contactButton}<span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
</div>
