---
import { projectsCopy } from "@/data/projects";
import "@/styles/projects.css";
import "@/styles/showcase.css";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const copy = projectsCopy[lang];
const contactUrl = lang === "es" ? "/es/contact" : "/contact";
const [featured, ecosystem, ...mobileProjects] = copy.projects;
---

<div class="projects-page">
  <section class="projects-hero showcase-hero section-sm">
    <div class="container showcase-wide">
      <p class="projects-kicker">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <div class="projects-intro">
        <p class="showcase-intro showcase-reading">{copy.introduction}</p>
        <ul aria-label="Capabilities">
          {copy.capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="projects-list section-sm" aria-labelledby="selected-work">
    <div class="container showcase-wide">
      <div class="showcase-section-heading">
        <div>
          <span class="showcase-section-index">01</span>
          <h2 id="selected-work">{copy.selectedWork}</h2>
        </div>
        <span class="showcase-section-meta">01 — 04</span>
      </div>

      <article class="project project-featured">
        <div class="project-copy">
          <div class="project-index">{featured.number}</div>
          <p class="project-eyebrow">{featured.eyebrow}</p>
          <h3>{featured.title}</h3>
          <p class="project-description">{featured.description}</p>
          {featured.note && <p class="project-note">{featured.note}</p>}
          <ul class="project-stack" aria-label="Technologies">
            {featured.stack.map((item) => <li>{item}</li>)}
          </ul>
          <div class="project-actions">
            {
              featured.links.map((link) =>
                link.url ? (
                  <a class={`project-link ${link.kind}`} href={link.url}>
                    {link.label}
                    <span>↗</span>
                  </a>
                ) : (
                  <span class="project-link is-disabled" aria-disabled="true">
                    {link.label}
                  </span>
                ),
              )
            }
          </div>
        </div>

        <div class="project-media media-dashboard" aria-label={copy.videoSoon}>
          <div class="media-toolbar">
            <i></i><i></i><i></i><span>ERP a medida / APP</span>
          </div>
          <div class="dashboard-shell">
            <div class="dashboard-sidebar">
              <span class="sidebar-brand"></span>
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="dashboard-content">
              <div class="dashboard-heading"><span></span><i></i></div>
              <div class="dashboard-stats">
                <span></span><span></span><span></span>
              </div>
              <div class="dashboard-table">
                <i></i><i></i><i></i><i></i><i></i>
              </div>
            </div>
          </div>
          <div class="media-status">
            <span class="play-icon">▶</span>{copy.videoSoon}
          </div>
        </div>
      </article>

      <article class="project project-ecosystem">
        <div class="project-head">
          <div>
            <div class="project-index">{ecosystem.number}</div>
            <p class="project-eyebrow">{ecosystem.eyebrow}</p>
            <h3>{ecosystem.title}</h3>
          </div>
          <p class="project-description">{ecosystem.description}</p>
        </div>

        <div class="ecosystem-media">
          <div class="browser-frame demain-website">
            <div class="browser-bar">
              <i></i><i></i><i></i><span>demainweb.dnsalias.com</span>
            </div>
            <div class="website-preview">
              <div class="website-copy">
                <small>DEMAIN INFORMÁTICA</small><strong
                  >Soporte técnico para tu día a día.</strong
                ><span></span><span></span><button>Ver servicios</button>
              </div>
              <div class="website-image"></div>
            </div>
          </div>
          <div class="phone-frame demain-app">
            <div class="phone-speaker"></div>
            <div class="app-header">
              <strong>D</strong><span>Work Orders</span>
            </div>
            <div class="app-filter"><span></span><i></i><i></i><i></i></div>
            <div class="app-orders">
              <span></span><span></span><span></span>
            </div>
            <div class="app-nav"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="project-footer">
          <ul class="project-stack" aria-label="Technologies">
            {ecosystem.stack.map((item) => <li>{item}</li>)}
          </ul>
          <div class="project-actions">
            {
              ecosystem.links.map((link) => (
                <a
                  class={`project-link ${link.kind}`}
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {link.label}
                  <span>↗</span>
                </a>
              ))
            }
          </div>
        </div>
      </article>

      <div class="mobile-projects">
        {
          mobileProjects.map((project) => (
            <article class="project project-mobile">
              <div class={`mobile-visual ${project.presentation}`}>
                <div class="phone-frame placeholder-phone">
                  <div class="phone-speaker" />
                  <div class="placeholder-mobile-header">
                    <>
                      <span />
                      <i />
                    </>
                  </div>
                  <div class="placeholder-mobile-hero">
                    <small>{project.id === "rentalmoto" ? "RM" : "RN"}</small>
                  </div>
                  <div class="placeholder-mobile-lines">
                    <>
                      <span />
                      <span />
                    </>
                  </div>
                  <div class="placeholder-mobile-cards">
                    <>
                      <i />
                      <i />
                    </>
                  </div>
                  <div class="placeholder-mobile-action" />
                </div>
                <span class="media-label">
                  {project.presentation === "native"
                    ? "Android / iOS"
                    : copy.mobileExperience}
                </span>
              </div>
              <div class="mobile-project-copy">
                <div class="project-index">{project.number}</div>
                <p class="project-eyebrow">{project.eyebrow}</p>
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>
                {project.note && <p class="project-note">{project.note}</p>}
                <ul class="project-stack" aria-label="Technologies">
                  {project.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <div class="project-actions">
                  {project.links.map((link) => (
                    <span class="project-link is-disabled" aria-disabled="true">
                      {link.label}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="projects-cta section-sm">
    <div class="container showcase-wide">
      <div class="cta-panel">
        <div>
          <p class="projects-kicker">
            {lang === "es" ? "¿Construimos algo?" : "Shall we build something?"}
          </p>
          <h2>{copy.closeTitle}</h2>
          <p>{copy.closeText}</p>
        </div>
        <a class="cta-link" href={contactUrl}>{copy.closeLink}<span>↗</span></a
        >
      </div>
    </div>
  </section>
</div>
