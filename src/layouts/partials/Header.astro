---
import menuJson from "@/config/menu.json";
import { getAlternateUrl, getLang, useTranslations } from "@/lib/i18n";

interface NavigationLink {
  name: string;
  url: string;
}

const { pathname } = Astro.url;
const lang = getLang(pathname);
const t = useTranslations(lang);
const menu: { main: NavigationLink[] } = menuJson[lang];
const alternateUrl = getAlternateUrl(pathname);
const alternateLang = lang === "en" ? "ES" : "EN";

const homeUrl = lang === "es" ? "/es" : "/";
const isHome = pathname === "/" || pathname === "/es";
---

<header class={`header mt-8 pb-3 pt-12`}>
  <nav class="navbar container text-center md:text-left">
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      for="nav-toggle"
      class="order-3 cursor-pointer btn btn-primary inline-flex items-center lg:order-1 md:hidden">
      <svg
        id="show-button"
        class="mr-1 h-4 w-4 fill-current block"
        viewBox="0 0 20 20">
        <title>{t.nav.menu}</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg
        id="hide-button"
        class="mr-1 h-4 w-4 fill-current hidden"
        viewBox="0 0 20 20">
        <title>{t.nav.menu_close}</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
      {t.nav.menu}
    </label>
    <!-- /navbar toggler -->

    {
      !isHome && (
        <div class="hidden text-center md:block">
          <a
            class="mb-12 inline-flex items-center text-primary hover:underline"
            href={homeUrl}>
            <svg
              class="mr-2"
              width="21"
              height="16"
              viewBox="0 0 21 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M.292892 7.29289c-.3905235.39053-.3905235 1.02369.0 1.41422L6.65685 15.0711C7.04738 15.4616 7.68054 15.4616 8.07107 15.0711 8.46159 14.6805 8.46159 14.0474 8.07107 13.6569L2.41421 8 8.07107 2.34315C8.46159 1.95262 8.46159 1.31946 8.07107.928932 7.68054.538408 7.04738.538408 6.65685.928932L.292892 7.29289zM21 7H1V9H21V7z"
                fill="currentcolor"
              />
            </svg>
            {t.nav.back_to_home}
          </a>
        </div>
      )
    }

    <ul
      id="nav-menu"
      class="navbar-nav order-3 w-full hidden justify-center md:order-1 md:flex md:w-auto md:space-x-2">
      {
        menu.main.map((item) => (
          <li class="nav-item">
            <a
              href={item.url}
              class={`nav-link inline-block text-text-dark ${
                (pathname === `${item.url}/` || pathname === item.url) &&
                "nav-link-active"
              }`}>
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Language switcher -->
    <a
      href={alternateUrl}
      data-astro-reload
      class="order-2 md:order-3 ml-auto md:ml-0 btn btn-outline-primary text-xs px-3 py-1 rounded font-semibold"
      aria-label={`Switch language to ${alternateLang}`}>
      {alternateLang}
    </a>
  </nav>
</header>
