---
import Base from "@/layouts/Base.astro";
---

<Base title="Message sent" meta_title="Thank you">
  <section class="section pt-[72px]">
    <div class="container">
      <div class="row">
        <div class="mx-auto lg:col-8 text-center">
          <h1 class="mt-12 text-4xl font-semibold">Message sent!</h1>
          <p class="mt-6 text-xl text-text">
            Thanks for reaching out. I'll get back to you as soon as possible.
          </p>
          <a href="/" class="btn btn-primary mt-10 inline-block rounded">
            Back to home
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
