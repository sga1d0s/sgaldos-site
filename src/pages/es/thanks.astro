---
import Base from "@/layouts/Base.astro";
---

<Base title="Mensaje enviado" meta_title="Gracias">
  <section class="section pt-[72px]">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-8 text-center">
          <h1 class="mt-12 text-4xl font-semibold">¡Mensaje enviado!</h1>
          <p class="mt-6 text-xl text-text">
            Gracias por escribirme. Te responderé lo antes posible.
          </p>
          <a href="/es" class="btn btn-primary mt-10 inline-block rounded">
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
