---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { useTranslations } from "@/lib/i18n";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";

const lang = "es";
const t = useTranslations(lang);
const contact = (await getEntry("contact", "es")) as CollectionEntry<"contact">;
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title } = contact.data;
const { Content } = await render(contact);
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="section pt-[72px]">
    <div class="container">
      <div class="row">
        <div class="mx-auto lg:col-8">
          <div class="content">
            <Content />
          </div>
          <div class="mt-12 pt-12">
            <h3
              set:html={markdownify(title)}
              class="h5 font-normal text-3xl"
            />
            <form id="contact-form" class="contact-form mt-6">
              <div class="row mb-6">
                <div class="md:col-6">
                  <label class="mb-2 block" for="name">{t.contact_form.name}</label>
                  <input
                    class="form-input w-full"
                    name="name"
                    type="text"
                    placeholder={t.contact_form.name_placeholder}
                    required
                  />
                </div>
                <div class="mt-6 md:mt-0 md:col-6">
                  <label class="mb-2 block" for="email">{t.contact_form.email}</label>
                  <input
                    class="form-input w-full"
                    name="email"
                    type="email"
                    placeholder={t.contact_form.email_placeholder}
                    required
                  />
                </div>
              </div>
              <div class="mb-6">
                <label class="mb-2 block" for="subject">{t.contact_form.subject}</label>
                <input
                  class="form-input w-full"
                  name="subject"
                  type="text"
                  placeholder={t.contact_form.subject_placeholder}
                  required
                />
              </div>
              <div class="mb-6">
                <label class="mb-2 block" for="message">{t.contact_form.message}</label>
                <textarea
                  class="form-textarea w-full"
                  name="message"
                  rows="6"
                  placeholder={t.contact_form.message_placeholder}
                />
              </div>
              <button type="submit" class="btn btn-primary cursor-pointer rounded text-sm">
                {t.contact_form.send}
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ action: contact_form_action }}>
  const form = document.getElementById("contact-form");
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const res = await fetch(action, {
      method: "POST",
      body: data,
      headers: { Accept: "application/json" },
    });
    if (res.ok) {
      window.location.href = "/es/thanks";
    }
  });
</script>
