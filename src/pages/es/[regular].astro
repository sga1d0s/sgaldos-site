---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

////////// FLAG UNDER CONSTRUCTION ///////////
import UnderConstructionEs from "@/components/UnderConstructionEs.astro";
const draft = true;
////////// FLAG UNDER CONSTRUCTION ///////////

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");
  // only Spanish pages (es/ subfolder)
  const esPages = pages.filter(
    (p) => p.id.startsWith("es/") && p.id !== "es/projects",
  );

  return esPages.map((page) => ({
    params: {
      regular: page.id.replace(/^es\//, "").replace(/\.(mdx?|md)$/, ""),
    },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  {
    draft ? (
      <UnderConstructionEs />
    ) : (
      <>
        <PageHeader title={title} />
        <section class="section-sm">
          <div class="container">
            <div class="row justify-center">
              <div class="lg:col-10">
                <div class="content">
                  <Content />
                </div>
              </div>
            </div>
          </div>
        </section>
      </>
    )
  }
</Base>
